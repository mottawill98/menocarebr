# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# dados locais (sincronização da Marketing API, config e token do pixel do
# redirect de WhatsApp) — nunca devem ser commitados
/data

# relatórios gerados (contêm números reais de gasto/receita/ROAS da conta) —
# saída local do script generate-report, nunca deve ir pro repositório
/reports

# permissões locais do Claude Code (pessoal, não compartilhado com o time)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

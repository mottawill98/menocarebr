# ============================================================================
# .env.example — referencia de TODAS as variaveis usadas no monorepo.
# Nunca commite valores reais. Cada app tem seu proprio arquivo de env real:
#   apps/dashboard/.env.local        (copie de apps/dashboard/.env.local.example)
#   apps/worker/.dev.vars            (copie de apps/worker/.dev.vars.example, uso local)
#   apps/worker -> `wrangler secret put <NOME>` (producao/staging)
#   packages/shared (scripts de migrate/seed) -> variaveis de shell/CI
# ============================================================================

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# String de conexao Postgres direta, usada pelos scripts migrate/seed (packages/shared).
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Meta Conversions API -------------------------------------------------
META_ACCESS_TOKEN=
META_DATASET_ID=
META_GRAPH_VERSION=v21.0
META_TEST_EVENT_CODE=

# --- CRM (DataCrazy ou equivalente) ---------------------------------------
CRM_WEBHOOK_SECRET=

# --- Cloudflare ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_QUEUE=tracking-clicks
CLOUDFLARE_KV_NAMESPACE=

# Token interno server-to-server (Dashboard -> Worker): invalidar cache do
# KV, reenviar evento Meta, enviar evento de teste. Diferente do CRM_WEBHOOK_SECRET.
WORKER_INTERNAL_API_TOKEN=
WORKER_URL=https://go.usemenocare.com.br

# --- URLs publicas -----------------------------------------------------
NEXT_PUBLIC_APP_URL=https://track.usemenocare.com.br
NEXT_PUBLIC_REDIRECT_BASE_URL=https://go.usemenocare.com.br

# --- Simulador (Admin/Dev, item 55) — nunca "true" em producao real -------
ALLOW_SIMULATOR_IN_PRODUCTION=false

# Publicas (expostas ao browser — nunca colocar segredo aqui)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REDIRECT_BASE_URL=https://go.usemenocare.com.br
NEXT_PUBLIC_APP_URL=https://track.usemenocare.com.br

# Privadas (somente server — Server Actions / Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=

# Worker (Cloudflare) — usado para invalidar cache do KV, reenviar eventos Meta e enviar evento de teste
WORKER_URL=https://go.usemenocare.com.br
WORKER_INTERNAL_API_TOKEN=

# Mostrados como "Meta configurada: SIM/NÃO" na página de Configurações (o token real fica só no Worker)
META_ACCESS_TOKEN=
META_DATASET_ID=
META_TEST_EVENT_CODE=

# Usado apenas pelo Simulador (Admin/Dev) para autenticar como se fosse o CRM
CRM_WEBHOOK_SECRET=

# Nunca "true" em produção real
ALLOW_SIMULATOR_IN_PRODUCTION=false

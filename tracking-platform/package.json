{
  "name": "tracking-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Meta Ads -> redirect -> WhatsApp -> CRM -> venda -> Meta Conversions API",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:dashboard": "pnpm --filter @tracking/dashboard dev",
    "dev:worker": "pnpm --filter @tracking/worker dev",
    "build": "pnpm --filter @tracking/shared build && pnpm --filter @tracking/dashboard build && pnpm --filter @tracking/worker build",
    "build:shared": "pnpm --filter @tracking/shared build",
    "build:dashboard": "pnpm --filter @tracking/shared build && pnpm --filter @tracking/dashboard build",
    "build:worker": "pnpm --filter @tracking/shared build && pnpm --filter @tracking/worker build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @tracking/dashboard test:e2e",
    "migrate": "pnpm --filter @tracking/shared run migrate",
    "seed": "pnpm --filter @tracking/shared run seed",
    "loadtest": "pnpm --filter @tracking/scripts loadtest",
    "mock:meta-capi": "pnpm --filter @tracking/scripts mock:meta-capi",
    "mock:crm": "pnpm --filter @tracking/scripts mock:crm"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
